{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.15.0/.schema/devbox.schema.json",
  "packages": [
    "binutils",
    "coreutils",
    "cpio",
    "dosfstools",
    "e2fsprogs",
    "file",
    "findutils",
    "gzip",
    "libisoburn",
    "syslinux",
    "util-linux",
    "wget",
    "xorriso",
    "xz",
    "mtools@latest",
    "gcc",
    "gnumake",
    "elfutils",
    "elfutils.dev",
    "bc",
    "perl",
    "bison",
    "flex",
    "openssl",
    "pkg-config",
    "ncurses.dev"
  ],
  "shell": {
    "init_hook": [
      "echo 'Devbox environment for Disk Wiper ISO builder initialized'"
    ],
    "scripts": {
      "build": "chmod +x ./build-disk-wiper.sh && ./build-disk-wiper.sh",
      "build-kernel": "chmod +x ./build-custom-kernel.sh && ./build-custom-kernel.sh",
      "clean": "rm -rf wiper-build kernel-build *.iso"
    }
  }
}
